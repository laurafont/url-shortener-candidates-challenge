# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Database (for Prisma in applications/web)
# Local: use postgresql://urlshortener:urlshortener@localhost:5432/urlshortener
# Docker: set by docker-compose to postgresql://urlshortener:urlshortener@postgres:5432/urlshortener
DATABASE_URL=postgresql://urlshortener:urlshortener@localhost:5432/urlshortener
